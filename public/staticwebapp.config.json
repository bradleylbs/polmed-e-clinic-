{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/service-worker.js",
      "/manifest.json",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.svg",
      "/*.ico"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "https://app-polmed-backend-fmamhma6g4gngfey.southafricanorth-01.azurewebsites.net/api/*",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/service-worker.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Cache-Control": "no-cache"
      }
    }
  ],
  "mimeTypes": {
    ".js": "application/javascript",
    ".json": "application/json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
